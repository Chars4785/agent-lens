{
  "name": "@agentlens/babel-plugin",
  "version": "0.1.0",
  "description": "Babel instrumentation for AgentLens React Native source metadata.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@babel/core": "^7.0.0"
  },
  "dependencies": {
    "@babel/types": "^7.24.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/babel__core": "^7.20.0",
    "typescript": "^5.4.0"
  }
}
